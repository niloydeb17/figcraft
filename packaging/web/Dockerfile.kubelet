# FigCraft web build from this repository, served by nginx with the collaboration server behind
# the same host name (for kubelet.cloud). Build from the repository root:
#   docker build -f packaging/web/Dockerfile.kubelet -t figcraft-web .
FROM rust:1-bookworm AS build
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git clang pkg-config \
 && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32-unknown-unknown \
 && if [ "$TARGETARCH" = "arm64" ]; then T=aarch64; else T=x86_64; fi \
 && curl -fsSL "https://github.com/trunk-rs/trunk/releases/latest/download/trunk-$T-unknown-linux-gnu.tar.gz" | tar -xz -C /usr/local/bin
WORKDIR /w
RUN git clone --depth 1 https://github.com/storytold/craft-fonts /w/craft-fonts
COPY . /w/figcraft
WORKDIR /w/figcraft/apps/figcraft-web
# The VPS cannot reliably download binaryen (wasm-opt) from GitHub, so skip that optional size step.
RUN sed -i 's/data-wasm-opt="z"/data-wasm-opt="0"/' index.html && grep -c 'data-wasm-opt="0"' index.html
RUN for i in 1 2 3 4 5; do trunk build --release && exit 0; echo "trunk build failed (attempt $i), retrying"; sleep 15; done; exit 1

FROM nginx:alpine
ARG PUBLIC_WSS=wss://figcraft.kubelet.cloud/
COPY --from=build /w/figcraft/dist/web /usr/share/nginx/html
RUN sed -i "s#</head>#<meta name=\"figcraft-server\" content=\"${PUBLIC_WSS}\"></head>#" /usr/share/nginx/html/index.html
# The public homepage, for whoever isn't signed in.
COPY homepage/index.html homepage/styles.css homepage/pixels.svg /usr/share/nginx/site/
COPY <<'EOF2' /etc/nginx/conf.d/default.conf
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
  listen 80;
  root /usr/share/nginx/html;
  gzip on;
  gzip_types application/wasm text/javascript text/html;
  gzip_min_length 1024;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  location /healthz { proxy_pass http://server:47900; }
  # Only a signed-in browser gets the editor: its page, code and live sessions. The server answers
  # 204 for a valid session cookie, 401 otherwise.
  location = /_signed_in {
    internal;
    proxy_pass http://server:47901/auth/check;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Upgrade "";
    proxy_set_header Connection "";
  }
  # Everyone else sees the homepage (any other path: its page, served here rather than redirected,
  # which would ask for a session again).
  location @site {
    root /usr/share/nginx/site;
    add_header Cache-Control "no-cache";
    try_files $uri $uri/index.html @site_page;
  }
  location @site_page {
    root /usr/share/nginx/site;
    add_header Cache-Control "no-cache";
    rewrite ^ /index.html break;
  }
  # Accounts: the server's sign-in pages and API.
  location = /login { proxy_pass http://server:47901; }
  location = /login.css { proxy_pass http://server:47901; }
  location = /login-art.svg { proxy_pass http://server:47901; }
  location = /logout { proxy_pass http://server:47901; }
  location ^~ /auth/ { proxy_pass http://server:47901; }
  location ~* \.(wasm|js)$ {
    auth_request /_signed_in;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
  location / {
    auth_request /_signed_in;
    error_page 401 = @site;
    if ($http_upgrade = "websocket") { proxy_pass http://server:47900; }
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
EOF2
