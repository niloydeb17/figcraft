# FigCraft web build from this repository, served by nginx with the collaboration server behind
# the same host name (for kubelet.cloud). Build from the repository root:
#   docker build -f packaging/web/Dockerfile.kubelet -t figcraft-web .
# Every input that runs or ships is pinned: the base images by digest, trunk by version and the
# checksum its release publishes, craft-fonts by commit. To move one on, change it here (and its
# checksum or digest) in a reviewed commit.
FROM rust:1-bookworm@sha256:e6f2cff35d0f309acf8433b4f05878ed77092602c5065cc81801177da0bb3a9c AS build
ARG TARGETARCH
ARG TRUNK_VERSION=0.22.1
ARG TRUNK_SHA256_X86_64=2ab8d548fd5ed9cda50906f61fd8654204e7893bd52ebbfd90533862b7d71ee1
ARG TRUNK_SHA256_AARCH64=b4017d1e0bfcffb4f4bee2be37c48def21e6e6896c3d0f503c43c42f714e57ea
# The same craft-fonts commit the release builds use (.github/workflows/release.yml).
ARG CRAFT_FONTS_REF=37827adc41fd165f9a9234ac40f94dbad353aa69
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git clang pkg-config \
 && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32-unknown-unknown \
 && if [ "$TARGETARCH" = "arm64" ]; then T=aarch64; SUM=$TRUNK_SHA256_AARCH64; else T=x86_64; SUM=$TRUNK_SHA256_X86_64; fi \
 && curl -fsSLo /tmp/trunk.tar.gz "https://github.com/trunk-rs/trunk/releases/download/v${TRUNK_VERSION}/trunk-$T-unknown-linux-gnu.tar.gz" \
 && echo "$SUM  /tmp/trunk.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/trunk.tar.gz -C /usr/local/bin && rm /tmp/trunk.tar.gz
WORKDIR /w
RUN git init -q /w/craft-fonts \
 && git -C /w/craft-fonts fetch -q --depth 1 https://github.com/storytold/craft-fonts "$CRAFT_FONTS_REF" \
 && git -C /w/craft-fonts checkout -q --detach FETCH_HEAD
COPY . /w/figcraft
WORKDIR /w/figcraft/apps/figcraft-web
# The VPS cannot reliably download binaryen (wasm-opt) from GitHub, so skip that optional size step.
RUN sed -i 's/data-wasm-opt="z"/data-wasm-opt="0"/' index.html && grep -c 'data-wasm-opt="0"' index.html
RUN for i in 1 2 3 4 5; do trunk build --release && exit 0; echo "trunk build failed (attempt $i), retrying"; sleep 15; done; exit 1

FROM nginx:alpine@sha256:713fc2ebfd92e8217db451477182ee91944b123d2b1ee9fd5a8c6e91ca6c3a11
ARG PUBLIC_WSS=wss://figcraft.kubelet.cloud/
COPY --from=build /w/figcraft/dist/web /usr/share/nginx/html
RUN sed -i "s#</head>#<meta name=\"figcraft-server\" content=\"${PUBLIC_WSS}\"></head>#" /usr/share/nginx/html/index.html
# The public homepage, for whoever isn't signed in.
COPY homepage/index.html homepage/styles.css homepage/pixels.svg /usr/share/nginx/site/
# The browser hardening every page and file of the app's own gets (included where a location sets
# headers of its own: nginx drops the server's add_header there). The proxied account pages send
# their own. No Content-Security-Policy yet: trunk's loader is an inline module script.
COPY <<'EOF3' /etc/nginx/security-headers.conf
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "same-origin" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
add_header Strict-Transport-Security "max-age=31536000" always;
EOF3
COPY <<'EOF2' /etc/nginx/conf.d/default.conf
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
  listen 80;
  root /usr/share/nginx/html;
  gzip on;
  gzip_types application/wasm text/javascript text/html;
  gzip_min_length 1024;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_set_header Host $host;
  # Dokploy's Traefik (on a private container network) is who connects here: believe the client
  # address it forwards, and hand the server that one address alone. The server believes it only
  # from these networks too (trusted_proxy in packaging/kubelet/server.toml).
  set_real_ip_from 10.0.0.0/8;
  set_real_ip_from 172.16.0.0/12;
  set_real_ip_from 192.168.0.0/16;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
  location /healthz { proxy_pass http://server:47900; }
  # Only a signed-in browser gets the editor: its page, code and live sessions. The server answers
  # 204 for a valid session cookie, 401 otherwise.
  location = /_signed_in {
    internal;
    proxy_pass http://server:47901/auth/check;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Upgrade "";
    proxy_set_header Connection "";
  }
  # Everyone else sees the homepage (any other path: its page, served here rather than redirected,
  # which would ask for a session again).
  location @site {
    root /usr/share/nginx/site;
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri $uri/index.html @site_page;
  }
  location @site_page {
    root /usr/share/nginx/site;
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "no-cache";
    rewrite ^ /index.html break;
  }
  # Accounts: the server's sign-in pages and API.
  location = /login { proxy_pass http://server:47901; }
  location = /login.css { proxy_pass http://server:47901; }
  location = /login-art.svg { proxy_pass http://server:47901; }
  location = /logout { proxy_pass http://server:47901; }
  location ^~ /auth/ { proxy_pass http://server:47901; }
  location ~* \.(wasm|js)$ {
    auth_request /_signed_in;
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
  location / {
    auth_request /_signed_in;
    error_page 401 = @site;
    if ($http_upgrade = "websocket") { proxy_pass http://server:47900; }
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
EOF2
